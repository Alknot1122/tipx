NODE_ENV=development
PORT=4000

# PostgreSQL (Neon / Railway / Render)
DATABASE_URL=postgresql://user:password@host:5432/tipx?sslmode=require

# JWT
JWT_SECRET=replace_me_with_a_64_char_random_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_me_with_another_64_char_random_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# The application_fee_amount is computed at runtime (0.5% of donation amount)

# CORS — only allow requests from the frontend origin
CORS_ORIGIN=https://tip.re-codex.com

# Redirect for root path
ROOT_REDIRECT_URL=https://re-codex.com
